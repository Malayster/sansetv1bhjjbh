generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
}

datasource db {
  provider = "sqlite"
}

model Urun {
  id                String          @id @default(uuid())
  slug              String          @unique
  ad                String
  fiyat             Float
  indirimliFiyat    Float?
  kisaAciklama      String?
  renkSecenekleri   String          @default("[]")
  boyutSecenekleri  String          @default("[]")
  iadeImkaniVar     Boolean         @default(true)
  agirlik           Float           @default(1) @map("desi")
  aciklama          String?
  resimUrl          String?
  aktif             Boolean         @default(true)
  oneCikan          Boolean         @default(false)
  firsatUrunu       Boolean         @default(false)
  yeniUrun          Boolean         @default(false)
  cokSatanlar       Boolean         @default(false)
  goruntulemeSayisi Int             @default(0)
  satisAdedi        Int             @default(0)
  stokAdedi         Int             @default(0)
  varyantBasligi    String?         @map("varyant_basligi")
  kategoriId        String?
  kategori          Kategori?       @relation(fields: [kategoriId], references: [id])
  markaId           String?
  marka             Marka?          @relation(fields: [markaId], references: [id])
  resimler          UrunResim[]
  siparisKalemleri  SiparisKalemi[]
  langgananItems    LanggananItem[]
  olusturulmaTarihi DateTime        @default(now())
  guncellenmeTarihi DateTime        @updatedAt

  @@index([ad])
  @@index([oneCikan, firsatUrunu, yeniUrun, cokSatanlar])
  @@index([satisAdedi])
  @@index([goruntulemeSayisi])
  @@map("urunler")
}

model UrunResim {
  id        String   @id @default(uuid())
  url       String
  sira      Int      @default(0)
  urunId    String
  urun      Urun     @relation(fields: [urunId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@map("urun_resimleri")
}

model Marka {
  id                String   @id @default(uuid())
  ad                String   @unique
  slug              String   @unique
  logoUrl           String?
  aktif             Boolean  @default(true)
  sira              Int      @default(0)
  urunler           Urun[]
  olusturulmaTarihi DateTime @default(now())
  guncellenmeTarihi DateTime @updatedAt
  @@map("markalar")
}

model Kategori {
  id                String     @id @default(uuid())
  ad                String
  slug              String     @unique
  resim             String?
  sira              Int        @default(0)
  aktif             Boolean    @default(true)
  ustKategoriId     String?
  ustKategori       Kategori?  @relation("KategoriHiyerarsisi", fields: [ustKategoriId], references: [id])
  altKategoriler    Kategori[] @relation("KategoriHiyerarsisi")
  urunler           Urun[]
  olusturulmaTarihi DateTime   @default(now())
  guncellenmeTarihi DateTime   @updatedAt
  @@map("kategoriler")
}

model Siparis {
  id                String          @id @default(uuid())
  siparisNumarasi   String          @unique
  takipTokeni       String?         @unique
  toplamTutar       Float
  kargoUcreti       Float           @default(0)
  kargoTakipNo      String?
  kargoFirmasi      String?
  durum             String          @default("BEKLEMEDE")
  faturaDurumu      String          @default("DUZENLENMEDI")
  faturaNo          String?
  faturaTarihi      DateTime?
  eposta            String
  ad                String
  soyad             String
  telefon           String
  adres             String
  sehir             String
  ilce              String
  postaKodu         String
  ulke              String          @default("Malaysia")
  kurumsalMi        Boolean         @default(false)
  sirketAdi         String?
  vergiDairesi      String?
  vergiNumarasi     String?
  odemeId           String?         @unique
  odemeTokeni       String?
  odemeDurumu       String?         @default("INIT")
  teslimTarihi      DateTime?
  langgananId       String?
  langganan         Langganan?      @relation(fields: [langgananId], references: [id])
  pointsEarned      Int             @default(0)
  kalemler          SiparisKalemi[]
  gecmis            IslemGecmisi[]
  iadeTalebi        IadeTalebi?
  olusturulmaTarihi DateTime        @default(now())
  guncellenmeTarihi DateTime        @updatedAt

  @@index([eposta])
  @@index([siparisNumarasi])
  @@index([takipTokeni])
  @@index([langgananId])
  @@map("siparisler")
}

model IadeTalebi {
  id                String   @id @default(uuid())
  siparisId         String   @unique
  siparis           Siparis  @relation(fields: [siparisId], references: [id])
  talepTipi         String   @map("iadeTipi")
  aciklama          String   @map("sebepAciklamasi")
  fotografUrls      String   @default("[]")
  resimUrl          String?
  manuelIadeKodu    String?
  kargoFirmasi      String?
  adminNotu         String?
  durum             String   @default("ONAY_BEKLENIYOR")
  olusturulmaTarihi DateTime @default(now())
  guncellenmeTarihi DateTime @updatedAt
  @@map("iade_talepleri")
}

model SiparisKalemi {
  id                    String  @id @default(uuid())
  siparisId             String
  siparis               Siparis @relation(fields: [siparisId], references: [id])
  urunId                String?
  urun                  Urun?   @relation(fields: [urunId], references: [id])
  secilenRenk           String?
  secilenBoyut          String?
  iadeyeUygunMuSnapshot Boolean @default(true)
  adet                  Int
  fiyat                 Float
  urunAdSnapshot        String
  urunFiyatSnapshot     Float
  toplamFiyat           Float
  @@map("siparis_kalemleri")
}

model IslemGecmisi {
  id         String   @id @default(uuid())
  siparisId  String
  siparis    Siparis  @relation(fields: [siparisId], references: [id])
  eskiDurum  String?
  yeniDurum  String
  not        String?
  islemYapan String   @default("SYSTEM")
  tarih      DateTime @default(now())
  @@map("islem_gecmisi")
}

model SistemAyarlari {
  id                    String   @id @default("global-settings")
  kargoAgirlikCarpani   Float    @default(0) @map("kargoDesiCarpani")
  ambarEsikAgirlik      Int      @default(0) @map("ambarEsikDesi")
  ucretsizKargoAltLimit Float?   @default(0)
  kargoFiyatListesi     String?
  kargoPolitikaTuru     String   @default("SABIT_UCRET")
  kargoSabitUcret       Float    @default(0)
  siteAdi               String   @default("E-Market")
  maintenanceMode       Boolean  @default(false)
  iletisimEmail         String?
  whatsappNumarasi      String?
  telefon               String?
  adres                 String?
  instagramUrl          String?
  facebookUrl           String?
  twitterUrl            String?
  youtubeUrl            String?
  metaPixelId           String?
  googleMerchantToken   String?
  gtmContainerId        String?
  ga4MeasurementId      String?
  hakkindaMetni         String?
  logoUrl               String?
  logoMode              String?  @default("image")
  faviconUrl            String?
  adminPin              String?  @default("dino1234")
  adminEmail            String?  @default("dinoempireenterprise@gmail.com")
  posKedah              Float?   @default(6.00)
  posSemenanjung        Float?   @default(8.00)
  posBorneo             Float?   @default(15.00)
  updatedAt             DateTime @updatedAt
  @@map("sistem_ayarlari")
}

model Langganan {
  id                String   @id @default(uuid())
  eposta            String
  ad                String
  soyad             String
  telefon           String
  alamat            String
  sehir             String
  poskod            String
  frekuensi         String   @default("BULANAN")
  status            String   @default("AKTIF")
  tarikhSeterusnya  DateTime
  skipSeterusnya    Boolean  @default(false)
  diskaunPeratus    Float    @default(0)
  jumlahAsas        Float
  jumlahAkhir       Float
  paymentToken      String?
  nota              String?
  items             LanggananItem[]
  pesanan           Siparis[]
  olusturulmaTarihi DateTime @default(now())
  guncellenmeTarihi DateTime @updatedAt
  @@index([eposta])
  @@index([status])
  @@index([tarikhSeterusnya])
  @@map("langganan")
}

model LanggananItem {
  id          String    @id @default(uuid())
  langgananId String
  langganan   Langganan @relation(fields: [langgananId], references: [id], onDelete: Cascade)
  urunId      String
  urun        Urun      @relation(fields: [urunId], references: [id])
  kuantiti    Int       @default(1)
  harga       Float
  @@index([langgananId])
  @@map("langganan_items")
}

// === Points / Loyalty ===
model Points {
  id          String   @id @default(uuid())
  eposta      String   @unique
  baki        Int      @default(0)
  jumlahDiperoleh Int  @default(0)
  jumlahDigunakan Int  @default(0)
  updatedAt   DateTime @updatedAt
  @@map("points")
}

model PointsLog {
  id        String   @id @default(uuid())
  eposta    String
  jumlah    Int
  jenis     String   // DAPAT, GUNA, TUKAR
  nota      String?
  rujukan   String?
  createdAt DateTime @default(now())
  @@index([eposta])
  @@map("points_log")
}
